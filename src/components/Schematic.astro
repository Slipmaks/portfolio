---
type Props = {
  caption: string;
};

const { caption } = Astro.props;
---

<figure class="schematic">
  <figcaption class="schematic-head">
    <h2 class="schematic-title">Schematic</h2>
    <p class="mono">{caption}</p>
  </figcaption>
  <ol class="schematic-steps" tabindex="0" aria-label="Schematic steps">
    <slot />
  </ol>
</figure>

<style>
  .schematic {
    margin-top: 64px;
  }

  .schematic-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 24px;
    margin-bottom: 24px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
  }

  .schematic-title {
    font: var(--type-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .schematic-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }

  @media (max-width: 960px) {
    .schematic-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .schematic-steps {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 24px;
      padding-bottom: 12px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      scrollbar-color: var(--ink-muted) transparent;
    }
  }
</style>
