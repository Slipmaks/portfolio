---
import type { CollectionEntry } from 'astro:content';
import MetricValue from './MetricValue.astro';

type Props = {
  entry: CollectionEntry<'cases'>;
  position: number;
  featured?: boolean;
};

const { entry, position, featured = false } = Astro.props;
const { company, metric, measures, title, summary } = entry.data;
const beforeAfter = featured ? (measures ?? []).filter((measure) => measure.value.includes('→')).slice(0, 4) : [];
const metricIsChange = metric.value.includes('→');
const titleLed = beforeAfter.length <= 1 && !metricIsChange;
---

<article class:list={['case-tile', { 'title-led': titleLed }]}>
  <h3 class="case-title"><a href={`/work/${entry.id}/`}>{title}</a></h3>
  <p class="mono case-meta">{String(position).padStart(2, '0')} · {company}</p>
  {
    titleLed ? (
      <p class="mono case-count">{metric.value} {metric.label}</p>
    ) : beforeAfter.length > 1 ? (
      <dl class="case-figures">
        {beforeAfter.map((measure) => (
          <div class="case-figure">
            <dt class="mono">{measure.short ?? measure.label}</dt>
            <dd class="case-metric">
              <MetricValue value={measure.value} />
            </dd>
          </div>
        ))}
      </dl>
    ) : (
      <>
        <p class="case-metric">
          <MetricValue value={metric.value} />
        </p>
        <p class="mono case-label">{metric.label}</p>
      </>
    )
  }
  <p class="case-summary">{summary}</p>
  <p class="case-more" aria-hidden="true">Read the case →</p>
</article>

<style>
  .case-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 16px;
    transition: background var(--ease-state);
  }

  @media (hover: hover) {
    .case-tile:hover {
      background: var(--accent-wash);
    }
  }

  .case-tile:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .case-meta {
    order: -3;
  }

  .case-metric {
    order: -2;
    margin-top: 24px;
    font: var(--type-display);
    letter-spacing: -0.025em;
  }

  .case-label {
    order: -1;
  }

  .case-figures {
    order: -2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 32px;
    margin-top: 24px;
  }

  @media (max-width: 960px) {
    .case-figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .case-figure {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .case-figure .case-metric {
    order: -1;
    margin-top: 0;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .case-figures {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .case-figure {
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
    }
  }

  @media (max-width: 380px) {
    .case-figures {
      gap: 12px;
    }

    .case-figure {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }

  .case-title {
    margin-top: 16px;
    font: var(--type-title);
    text-wrap: balance;
  }

  .title-led .case-title {
    margin-top: 24px;
  }

  .case-title a,
  .case-title a:hover {
    color: inherit;
    text-decoration: none;
  }

  .case-title a:focus-visible {
    outline: none;
  }

  .case-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .case-summary {
    max-width: var(--measure-prose);
    color: var(--ink-2);
    flex-grow: 1;
  }

  .case-more {
    margin-top: 16px;
    font: var(--type-control);
    color: var(--accent);
  }
</style>
