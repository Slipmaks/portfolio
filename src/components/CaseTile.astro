---
import type { CollectionEntry } from 'astro:content';
import MetricValue from './MetricValue.astro';

type Props = {
  entry: CollectionEntry<'cases'>;
  position: number;
};

const { entry, position } = Astro.props;
const { company, metric, title, summary } = entry.data;
---

<article class="case-tile">
  <h3 class="case-title"><a href={`/work/${entry.id}/`}>{title}</a></h3>
  <p class="mono case-meta">{String(position).padStart(2, '0')} · {company}</p>
  <p class="case-metric"><MetricValue value={metric.value} /></p>
  <p class="mono case-label">{metric.label}</p>
  <p class="case-summary">{summary}</p>
  <p class="case-more" aria-hidden="true">Read the case →</p>
</article>

<style>
  .case-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 16px;
    transition: background var(--ease-state);
  }

  .case-tile:hover {
    background: var(--accent-wash);
  }

  .case-tile:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .case-meta {
    order: -3;
  }

  .case-metric {
    order: -2;
    margin-top: 24px;
    font: var(--type-display);
    letter-spacing: -0.025em;
  }

  .case-label {
    order: -1;
  }

  .case-title {
    margin-top: 16px;
    font: var(--type-name);
  }

  .case-title a,
  .case-title a:hover {
    color: inherit;
    text-decoration: none;
  }

  .case-title a:focus-visible {
    outline: none;
  }

  .case-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .case-summary {
    max-width: var(--measure-prose);
    color: var(--ink-2);
    flex-grow: 1;
  }

  .case-more {
    margin-top: 16px;
    font: var(--type-control);
    color: var(--accent);
  }
</style>
