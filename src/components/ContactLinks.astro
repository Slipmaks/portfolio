---
import { statSync } from 'node:fs';
import { profile } from '../data/profile';

const cvKilobytes = Math.round(statSync(`public${profile.cv}`).size / 1024);
---

<div class="contact-group">
  <ul class="contacts">
    <li><a class="button button-primary" href={profile.cv} download>Download CV<span class="visually-hidden"> (PDF)</span></a></li>
    <li><a class="button" href={profile.linkedin} rel="me">LinkedIn</a></li>
    <li class="email">
      <a class="button" href={`mailto:${profile.email}`}>{profile.email}</a>
      <button class="button copy" type="button" data-copy={profile.email} aria-label="Copy email address" hidden>Copy</button>
      <span class="visually-hidden" role="status" data-copy-status></span>
    </li>
  </ul>
  <p class="mono contacts-note">
    <span>CV: PDF, {cvKilobytes} KB, updated {profile.cvUpdated}</span>
    <span>Also on <a href={profile.telegram} rel="me">Telegram</a></span>
  </p>
</div>

<script>
  const canCopy = window.isSecureContext && typeof navigator.clipboard?.writeText === 'function';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    if (!canCopy) continue;
    button.hidden = false;
    const status = button.parentElement?.querySelector('[data-copy-status]');
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      let result = 'Copied';
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        result = 'Copy failed';
      }
      button.textContent = result;
      if (status) status.textContent = result === 'Copied' ? 'Email copied' : 'Could not copy the email';
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        button.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 1600);
    });
  }
</script>

<style>
  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .contacts-note {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin-top: 12px;
  }

  .contacts-note a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    color: var(--ink);
  }

  .email {
    display: flex;
  }

  .copy {
    border-left: 0;
    min-width: 72px;
    justify-content: center;
  }

  .copy[hidden] {
    display: none;
  }
</style>
