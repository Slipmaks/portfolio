---
import Schematic from '../Schematic.astro';
import Step from '../SchematicStep.astro';

const photoRows = [18, 38, 58];
---

<Schematic caption="Offline first · uploads that can be retried safely">
  <Step index={1} name="Offline">
    <svg viewBox="0 0 240 96">
      <rect x="8" y="8" width="48" height="80" />
      {photoRows.map((y) => (
        <>
          <rect x="16" y={y} width="12" height="12" class="muted" />
          <line x1="32" y1={y + 6} x2="48" y2={y + 6} class="muted" />
        </>
      ))}
      <line x1="56" y1="48" x2="104" y2="48" class="muted" />
      <rect x="108" y="28" width="124" height="40" class="signal" />
      <text x="170" y="52" text-anchor="middle" class="ink">by id, not url</text>
      <text x="108" y="86">no signal</text>
    </svg>
    <Fragment slot="text">The notebook opens with no signal. Photos are kept by ID, not by URL, so re-signed links never download them again.</Fragment>
  </Step>
  <Step index={2} name="Upload">
    <svg viewBox="0 0 240 96">
      <rect x="8" y="16" width="40" height="40" />
      <line x1="28" y1="56" x2="28" y2="64" class="signal" />
      <rect x="8" y="64" width="40" height="18" class="signal" />
      <text x="28" y="77" text-anchor="middle" class="signal">key</text>
      <path d="M56 48H96M92 44.5 96 48 92 51.5" class="signal" />
      <rect x="100" y="32" width="48" height="32" />
      <text x="124" y="52" text-anchor="middle" class="ink">api</text>
      <path d="M150 48H176M172 44.5 176 48 172 51.5" class="muted" />
      <rect x="180" y="24" width="52" height="48" />
      <line x1="180" y1="40" x2="232" y2="40" class="muted" />
      <line x1="180" y1="56" x2="232" y2="56" class="muted" />
      <text x="206" y="16" text-anchor="middle">unique</text>
    </svg>
    <Fragment slot="text">Every photo carries an idempotency key, backed by a unique index in PostgreSQL.</Fragment>
  </Step>
  <Step index={3} name="Race">
    <svg viewBox="0 0 240 96">
      <text x="8" y="40" class="ink">A</text>
      <path d="M24 36H156M152 32.5 156 36 152 39.5" class="signal" />
      <text x="8" y="66" class="ink">B</text>
      <path d="M24 62H136" />
      <line x1="142" y1="54" x2="142" y2="70" />
      <rect x="160" y="24" width="72" height="48" />
      <text x="196" y="52" text-anchor="middle" class="ink">row</text>
      <text x="196" y="16" text-anchor="middle">unique</text>
    </svg>
    <Fragment slot="text">If two attempts race, the unique index lets exactly one of them write the row.</Fragment>
  </Step>
  <Step index={4} name="Resolve">
    <svg viewBox="0 0 240 96">
      <text x="8" y="40" class="ink">A</text>
      <path d="M24 36H156M152 32.5 156 36 152 39.5" class="signal" />
      <text x="8" y="66" class="ink">B</text>
      <path d="M156 62H24M28 58.5 24 62 28 65.5" />
      <rect x="160" y="24" width="72" height="48" />
      <text x="196" y="52" text-anchor="middle" class="ink">row A</text>
      <rect x="60" y="72" width="16" height="16" class="muted dashed" />
      <line x1="60" y1="88" x2="76" y2="72" class="muted" />
      <text x="84" y="86">deleted</text>
    </svg>
    <Fragment slot="text">The loser deletes its own files and gets the winner’s row back. A photo is never stored twice.</Fragment>
  </Step>
</Schematic>
