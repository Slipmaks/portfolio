---
const tenants = [
  { name: 'tenant-a', y: 8 },
  { name: 'tenant-b', y: 38 },
  { name: 'tenant-c', y: 68 },
];
---

<svg class="drawing" viewBox="0 0 240 96">
  <rect x="8" y="32" width="56" height="32" />
  <text x="36" y="52" text-anchor="middle" class="ink">image</text>
  {tenants.map(({ name, y }) => (
    <>
      <line x1="64" y1="48" x2="128" y2={y + 10} class="muted" />
      <rect x="128" y={y} width="104" height="20" />
      <text x="136" y={y + 14} class="ink">{name}</text>
    </>
  ))}
</svg>
