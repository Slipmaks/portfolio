---
import Schematic from '../Schematic.astro';
import Step from '../SchematicStep.astro';

const tenants = [
  { name: 'tenant-a', y: 8 },
  { name: 'tenant-b', y: 38 },
  { name: 'tenant-c', y: 68 },
];
const frontends = [8, 30, 52, 74];
---

<Schematic caption="One build for every tenant and environment">
  <Step index={1} name="Build">
    <svg viewBox="0 0 240 96">
      <rect x="8" y="32" width="56" height="32" />
      <text x="36" y="52" text-anchor="middle" class="ink">src</text>
      <path d="M68 48H92M88 44.5 92 48 88 51.5" class="muted" />
      <line x1="100" y1="24" x2="100" y2="72" />
      <line x1="108" y1="24" x2="108" y2="72" />
      <text x="104" y="16" text-anchor="middle" class="ink">vue-tsc</text>
      <text x="104" y="88" text-anchor="middle">strict</text>
      <path d="M116 48H144M140 44.5 144 48 140 51.5" class="signal" />
      <rect x="148" y="32" width="84" height="32" class="signal" />
      <text x="190" y="52" text-anchor="middle" class="ink">bundle</text>
    </svg>
    <Fragment slot="text">vue-tsc runs in strict mode in every build. A type error stops the release.</Fragment>
  </Step>
  <Step index={2} name="Deploy">
    <svg viewBox="0 0 240 96">
      <rect x="8" y="16" width="132" height="64" />
      <text x="16" y="32" class="ink">deploy</text>
      <rect x="16" y="44" width="56" height="28" class="muted" />
      <text x="44" y="62" text-anchor="middle">bundle</text>
      <path d="M80 44H120L128 52V72H80ZM120 44V52H128" class="signal" />
      <text x="104" y="64" text-anchor="middle" class="signal">config</text>
      <path d="M188 58H134M138 54.5 134 58 138 61.5" class="signal" />
      <text x="194" y="62" class="ink">CI</text>
    </svg>
    <Fragment slot="text">The API address is never baked in. CI writes a runtime config next to the bundle at deploy.</Fragment>
  </Step>
  <Step index={3} name="Open">
    <svg viewBox="0 0 240 96">
      <rect x="8" y="32" width="56" height="32" />
      <text x="36" y="52" text-anchor="middle" class="ink">image</text>
      {tenants.map(({ name, y }) => (
        <>
          <line x1="64" y1="48" x2="128" y2={y + 10} class="muted" />
          <rect x="128" y={y} width="104" height="20" />
          <text x="136" y={y + 14} class="ink">{name}</text>
        </>
      ))}
    </svg>
    <Fragment slot="text">The tenant comes from the subdomain, so one Docker image serves every tenant company.</Fragment>
  </Step>
  <Step index={4} name="Request">
    <svg viewBox="0 0 240 96">
      <text x="108" y="12" text-anchor="middle" class="signal">X-Client-Id</text>
      {frontends.map((y, index) => (
        <>
          <rect x="8" y={y} width="40" height="14" class={index === 1 ? 'signal' : 'muted'} />
          <line x1="48" y1={y + 7} x2="168" y2="48" class={index === 1 ? 'signal' : 'muted'} />
        </>
      ))}
      <rect x="168" y="32" width="64" height="32" />
      <text x="200" y="52" text-anchor="middle" class="ink">api</text>
    </svg>
    <Fragment slot="text">Every request carries an X-Client-Id header, so one backend can tell its four frontends apart.</Fragment>
  </Step>
</Schematic>
