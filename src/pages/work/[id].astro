---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import CaseTile from '../../components/CaseTile.astro';
import MetricValue from '../../components/MetricValue.astro';
import StackList from '../../components/StackList.astro';
import { scaleOf, splitChange } from '../../lib/figures';
import { keepRangeTogether, keepSeparatorsTogether } from '../../lib/text';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
  const numbered = cases.map((entry, index) => ({ entry, position: index + 1 }));
  return numbered.map(({ entry, position }, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      position,
      others: [...numbered.slice(index + 1), ...numbered.slice(0, index)],
      total: cases.length,
    },
  }));
}

type Props = {
  entry: CollectionEntry<'cases'>;
  position: number;
  others: { entry: CollectionEntry<'cases'>; position: number }[];
  total: number;
};

const { entry, position, others, total } = Astro.props;
const twoDigits = (value: number) => String(value).padStart(2, '0');
const { Content } = await render(entry);
const { title, company, period, role, summary, metric, measures, stack } = entry.data;
const hasMeasures = (measures?.length ?? 0) > 0;
const measuresHeading = measures?.some((measure) => splitChange(measure.value)) ? 'Measured' : 'Scope';

---

<Base title={`${title} — ${profile.name}`} description={summary}>
  <div class="page">
    <nav class="crumbs mono" aria-label="Profile">
      <p class="crumbs-who">
        <a class="crumbs-home" href="/"><span aria-hidden="true">← </span>{profile.name}</a>
        <span>{keepSeparatorsTogether(profile.title)}&nbsp;|&nbsp;{profile.focus}</span>
      </p>
      <p class="crumbs-actions">
        <span class="status">{profile.status}</span>
        <a class="crumbs-cv" href={profile.cv} download>Download CV</a>
      </p>
    </nav>
  </div>
  <main class="page" id="content" tabindex="-1">
    <header class="case-head">
      <p class="mono">Case {twoDigits(position)} / {twoDigits(total)} · {company} · {keepRangeTogether(period)} · {role}</p>
      <h1 class="case-title">{title}</h1>
      <p class="case-summary">{summary}</p>
      {
        !hasMeasures && (
          <dl class="case-facts">
            <div>
              <dt class="mono">Result</dt>
              <dd class="case-metric"><MetricValue value={metric.value} /></dd>
              <dd class="mono">{metric.label}</dd>
            </div>
            <div>
              <dt class="mono">Stack</dt>
              <dd><StackList items={stack} /></dd>
            </div>
          </dl>
        )
      }
    </header>

    <div class:list={['case-body', { 'case-body-flush': hasMeasures }]}>
      {
        hasMeasures && (
          <aside class="measures" aria-labelledby="measures-title">
            <h2 class="measures-title" id="measures-title">{measuresHeading}</h2>
            <dl>
              {measures!.map((measure) => {
                const scale = scaleOf(measure.value);
                return (
                  <div class="measure">
                    <dt class="mono">{measure.label}</dt>
                    <dd class="measure-value">
                      <MetricValue value={measure.value} />
                    </dd>
                    {scale && (
                      <dd class="measure-scale" aria-hidden="true">
                        <span class="scale-before" style={`--scale: ${scale.before}%`} />
                        <span class="scale-after" style={`--scale: ${scale.after}%`} />
                      </dd>
                    )}
                  </div>
                );
              })}
            </dl>
            <h2 class="measures-title">Stack</h2>
            <StackList items={stack} />
          </aside>
        )
      }
      <article class="prose">
        <Content />
      </article>
    </div>

    <section class="section" aria-labelledby="more-title">
      <div class="section-head">
        <h2 class="section-title" id="more-title">More work</h2>
        <a class="section-index" href="/#work-title">All work</a>
      </div>
      <ol class="tile-grid">
        {
          others.map((other) => (
            <li>
              <CaseTile entry={other.entry} position={other.position} />
            </li>
          ))
        }
      </ol>
    </section>

  </main>
  <footer class="page">
    <div class="section case-footer">
      <p class="footer-lead">Let’s talk.</p>
      <p class="footer-intent">{profile.contactNote}</p>
      <ContactLinks />
    </div>
  </footer>
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    padding: 24px 0 12px;
    border-bottom: 1px solid var(--hairline);
  }

  .crumbs-who,
  .crumbs-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
  }

  .crumbs a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    text-decoration: none;
  }

  .crumbs-home {
    color: var(--ink);
  }

  .crumbs-cv {
    color: var(--accent);
  }

  .case-head {
    margin-top: 48px;
  }

  .case-title {
    margin-top: 16px;
    font: 700 clamp(32px, 5vw, 56px) / 1 var(--font-sans);
    letter-spacing: -0.035em;
    max-width: 20ch;
  }

  .case-summary {
    margin-top: 24px;
    max-width: var(--measure-lead);
    font: var(--type-lead);
    color: var(--ink-2);
  }

  .case-facts {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) 2fr;
    gap: 24px;
    margin-top: 48px;
    padding-top: 16px;
    border-top: 2px solid var(--rule);
  }

  .case-facts dd {
    margin-top: 8px;
  }

  .case-metric {
    font: var(--type-display);
    letter-spacing: -0.025em;
  }

  .case-body {
    display: grid;
    grid-template-columns: minmax(0, var(--measure-prose)) minmax(240px, 1fr);
    gap: 48px 64px;
    align-items: start;
    margin-top: 64px;
  }

  .case-body-flush :global(.prose > h2:first-child),
  .case-body-flush .measures-title:first-child {
    margin-top: 0;
  }

  .prose {
    grid-column: 1;
    grid-row: 1;
    max-width: var(--measure-prose);
  }

  .measures {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 24px;
  }

  .prose :global(h2),
  .measures-title {
    margin: 48px 0 16px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
    font: var(--type-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .measure {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .measure:first-child {
    padding-top: 0;
  }

  .measure-value {
    order: -1;
    font: var(--type-display);
    letter-spacing: -0.025em;
  }

  .measure-scale {
    display: grid;
    gap: 3px;
    margin-top: 8px;
  }

  .measure-scale span {
    display: block;
    width: var(--scale);
    height: 6px;
  }

  .measure-scale .scale-before {
    border: 1px solid var(--ink-muted);
  }

  .measure-scale .scale-after {
    background: var(--ink);
  }

  @media (max-width: 960px) {
    .case-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .prose,
    .measures {
      grid-column: 1;
      grid-row: auto;
    }

    .measures {
      position: static;
      max-width: var(--measure-prose);
    }
  }

  .prose :global(p),
  .prose :global(ul) {
    margin-bottom: 16px;
  }

  .prose :global(li) {
    position: relative;
    padding-left: 20px;
    margin-bottom: 8px;
  }

  .prose :global(li)::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .prose :global(code) {
    font: var(--type-mono-code);
    background: var(--paper-sunk);
    padding: 0 4px;
  }

  .case-footer {
    margin-bottom: 64px;
  }

  .footer-lead {
    font: var(--type-display);
  }

  .footer-intent {
    margin: 8px 0 24px;
    max-width: var(--measure-lead);
    font: var(--type-lead);
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .case-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
