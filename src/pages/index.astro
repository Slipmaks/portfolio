---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CaseTile from '../components/CaseTile.astro';
import StackList from '../components/StackList.astro';
import { profile, experience, projects } from '../data/profile';
import { keepRangeTogether, keepSeparatorsTogether } from '../lib/text';
import { durationOf } from '../lib/duration';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const techGraph = projects.find((project) => project.name === 'Tech graph');
const twoDigits = (value: number) => String(value).padStart(2, '0');
const caseById = new Map(cases.map((entry) => [entry.id, entry.data.short ?? entry.data.title]));
const jobGroups = [
  { label: null, jobs: experience.filter((job) => !job.alongside && !job.earlier) },
  { label: 'Earlier', jobs: experience.filter((job) => job.earlier && !job.alongside) },
  { label: 'Alongside, part-time', jobs: experience.filter((job) => job.alongside) },
].filter((group) => group.jobs.length > 0);
---

<Base
  title={`${profile.name} — ${profile.title} | ${profile.focus}`}
  description={profile.summary}
>
  <main class="page" id="content" tabindex="-1">
    <header class="hero">
      <div class="hero-meta mono">
        <span class="status">{profile.status}</span>
        <nav class="hero-jump" aria-label="Sections">
          <a href="#work-title">Work</a>
          <a href="#experience-title">Experience</a>
          <a href="#contact">Contact</a>
        </nav>
        <ThemeToggle />
      </div>
      <div class="hero-body">
        <div>
          <h1 class="hero-name">{profile.name}</h1>
          <p class="hero-title">{keepSeparatorsTogether(profile.title)}&nbsp;|&nbsp;{profile.focus}</p>
        </div>
      </div>
      <dl class="hero-spec">
        {
          profile.spec.map((item) => (
            <div>
              <dt class="mono">{item.label}</dt>
              <dd class="hero-spec-value">{item.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="hero-summary">{profile.lead}</p>
      <ContactLinks />
    </header>

    <section class="section" aria-labelledby="work-title">
      <div class="section-head">
        <h2 class="section-title" id="work-title">Selected work</h2>
        <span class="section-index">{twoDigits(cases.length)} cases</span>
      </div>
      <ol class="cases tile-grid">
        {
          cases.map((entry, index) => (
            <li class="case">
              <CaseTile entry={entry} position={index + 1} featured={index === 0} />
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="experience-title">
      <div class="section-head">
        <h2 class="section-title" id="experience-title">Experience</h2>
      </div>
      {
        jobGroups.map((group) => (
          <>
            {group.label && <h3 class="jobs-group">{group.label}</h3>}
            <ol class="jobs">
              {group.jobs.map((job) => {
                const JobHeading = group.label ? 'h4' : 'h3';
                return (
                <li class="job">
                  <p class="mono job-period">
                    <span>{keepRangeTogether(job.period)}</span>
                    <span class="job-duration">{durationOf(job.period)}</span>
                  </p>
                  <div>
                    <JobHeading class="job-head">
                      {`${job.company} `}<span class="mono">{job.country}</span>
                    </JobHeading>
                    <p class="job-role">{job.role}</p>
                    <p class="job-note">{job.note}</p>
                  </div>
                  {job.cases && (
                    <ul class="job-cases">
                      {job.cases
                        .map((id) => ({ id, name: caseById.get(id) }))
                        .filter(({ name }) => name)
                        .map(({ id, name }) => (
                          <li>
                            <a href={`/work/${id}/`}>
                              {name} <span aria-hidden="true">→</span>
                            </a>
                          </li>
                        ))}
                    </ul>
                  )}
                </li>
                );
              })}
            </ol>
          </>
        ))
      }
    </section>

    <section class="section" aria-labelledby="skills-title">
      <div class="section-head">
        <h2 class="section-title" id="skills-title">Skills</h2>
        {techGraph?.url && <a class="section-index" href={techGraph.url}>Full map in Tech graph <span aria-hidden="true">↗</span></a>}
      </div>
      <dl class="skills">
        {
          profile.skills.map((skill) => (
            <div class="skill">
              <dt class="mono">{skill.group}</dt>
              <dd>
                <ul class="skill-items">
                  {skill.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="section" aria-labelledby="projects-title">
      <div class="section-head">
        <h2 class="section-title" id="projects-title">Projects</h2>
        <a class="section-index" href={profile.github} rel="me">GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="projects">
        {
          projects.map((project) => (
            <li class="project">
              <h3 class="project-name">
                {project.url ? <a href={project.url}>{project.name} <span aria-hidden="true">↗</span></a> : project.name}
              </h3>
              <p>{project.description}</p>
              <StackList items={project.stack.split(' · ')} />
            </li>
          ))
        }
      </ul>
    </section>

  </main>
  <footer class="page">
    <div class="section footer" id="contact">
      <p class="footer-lead">Let’s talk.</p>
      <p class="footer-intent">{profile.contactNote}</p>
      <ContactLinks />
    </div>
  </footer>
</Base>

<style>
  .hero {
    padding-top: 48px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hairline);
  }

  .hero-jump {
    display: flex;
    gap: 16px;
    margin-left: auto;
  }

  .hero-jump a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    color: var(--ink-2);
  }

  .hero-body {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-top: 32px;
  }

  .hero-name {
    font: var(--type-hero);
    letter-spacing: -0.04em;
    max-width: 10ch;
  }

  .hero-title {
    margin-top: 16px;
    font: var(--type-title);
  }


  .hero-spec {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-top: 24px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
  }

  .hero-spec-value {
    margin-top: 4px;
    font: var(--type-name);
  }

  .hero-summary {
    margin: 16px 0 24px;
    max-width: var(--measure-lead);
    font: var(--type-lead);
    color: var(--ink-2);
  }

  .case:first-child {
    grid-column: 1 / -1;
  }

  .job {
    display: grid;
    grid-template-columns: 160px 1fr auto;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .jobs-group {
    margin-top: 32px;
    padding-bottom: 8px;
    font: var(--type-mono);
    color: var(--ink-2);
    border-bottom: 1px solid var(--hairline);
  }

  .job-cases {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    padding-top: 2px;
  }

  .job-cases a {
    display: inline-block;
    padding-block: 6px;
    margin-block: -6px;
    font: var(--type-mono);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .job-period {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 2px;
  }

  .job-duration {
    color: var(--ink-muted);
  }

  .job-head {
    font: var(--type-prose);
    font-weight: 700;
  }

  .job-role {
    color: var(--ink-2);
  }

  .job-note {
    margin-top: 4px;
    max-width: var(--measure-prose);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
  }

  .project-name {
    font: var(--type-name);
  }

  .project-name a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
  }

  .skill {
    display: grid;
    grid-template-columns: 160px 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .skill dd {
    overflow: clip;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    margin-left: -24px;
    font: var(--type-name);
  }

  .skill-items li {
    position: relative;
    margin-left: 24px;
  }

  .skill-items li::before {
    content: "·" / "";
    position: absolute;
    left: -15px;
    color: var(--ink-muted);
  }

  .footer {
    margin-bottom: 64px;
    scroll-margin-top: 32px;
  }

  .footer-lead {
    font: var(--type-display);
  }

  .footer-intent {
    margin: 8px 0 24px;
    max-width: var(--measure-lead);
    font: var(--type-lead);
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .hero-jump {
      order: 1;
      flex-basis: 100%;
      margin-left: 0;
    }

    .hero-meta :global(.theme-field) {
      margin-left: auto;
    }

    .hero {
      padding-top: 24px;
    }

    .hero-body {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 0 12px;
      margin-top: 32px;
    }

    .hero-body > div {
      display: contents;
    }

    .hero-name {
      font-size: clamp(32px, 11vw, 56px);
    }


    .hero-title {
      grid-column: 1 / -1;
    }

    .hero-spec {
      gap: 12px 32px;
      margin-top: 24px;
    }

    .hero-summary {
      margin: 20px 0 24px;
      font: var(--type-lead-compact);
    }

    .job,
    .skill {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .job-cases {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 20px;
      padding-top: 4px;
    }

    .job-cases a {
      padding-block: 12px;
      margin-block: -12px;
    }
  }
</style>
