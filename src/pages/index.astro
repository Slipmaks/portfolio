---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import photo from '../assets/photo.jpg';
import { profile, experience, projects } from '../data/profile';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const techGraph = projects.find((project) => project.name === 'Tech graph');
const twoDigits = (value: number) => String(value).padStart(2, '0');
---

<Base
  title={`${profile.name} — ${profile.title} | ${profile.focus}`}
  description={profile.summary}
>
  <main class="page">
    <header class="hero">
      <div class="hero-meta mono">
        <span class="status">{profile.status}</span>
        <span>{profile.location}</span>
      </div>
      <div class="hero-body">
        <div>
          <h1 class="hero-name">{profile.name}</h1>
          <p class="hero-title">{profile.title} <span class="divider">|</span> {profile.focus}</p>
        </div>
        <Image class="hero-photo" src={photo} alt={profile.name} width={160} height={160} loading="eager" />
      </div>
      <p class="hero-summary">{profile.summary}</p>
      <ContactLinks />
    </header>

    <section class="section" aria-labelledby="work-title">
      <div class="section-head">
        <h2 class="section-title" id="work-title">Selected work</h2>
        <span class="section-index">{twoDigits(cases.length)} cases</span>
      </div>
      <ol class="cases">
        {
          cases.map((entry, index) => (
            <li class="case">
              <a class="case-link" href={`/work/${entry.id}/`}>
                <span class="mono">
                  {twoDigits(index + 1)} · {entry.data.company}
                </span>
                <span class="case-metric">{entry.data.metric.value}</span>
                <span class="mono">{entry.data.metric.label}</span>
                <span class="case-title">{entry.data.title}</span>
                <span class="case-summary">{entry.data.summary}</span>
                <span class="case-more">Read the case →</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="experience-title">
      <div class="section-head">
        <h2 class="section-title" id="experience-title">Experience</h2>
        <a class="section-index" href={profile.cv} download>Full CV (PDF)</a>
      </div>
      <ol class="jobs">
        {
          experience.map((job) => (
            <li class="job">
              <span class="mono job-period">{job.period}</span>
              <div>
                <p class="job-head">
                  <strong>{job.company}</strong> <span class="mono">{job.country}</span>
                </p>
                <p class="job-role">{job.role}</p>
                <p class="job-note">{job.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="projects-title">
      <div class="section-head">
        <h2 class="section-title" id="projects-title">Projects</h2>
      </div>
      <ul class="projects">
        {
          projects.map((project) => (
            <li class="project">
              <h3 class="project-name">
                {project.url ? <a href={project.url}>{project.name} ↗</a> : project.name}
              </h3>
              <p>{project.description}</p>
              <p class="mono">{project.stack}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="skills-title">
      <div class="section-head">
        <h2 class="section-title" id="skills-title">Skills</h2>
      </div>
      <p class="skills">{profile.coreStack.join(' · ')}</p>
      {
        techGraph?.url && (
          <a class="button skills-map" href={techGraph.url}>
            Full skills map → Tech graph
          </a>
        )
      }
    </section>

    <footer class="section footer">
      <p class="footer-lead">Let’s talk.</p>
      <ContactLinks />
      <p class="mono footer-note">{profile.location}</p>
    </footer>
  </main>
</Base>

<style>
  .hero {
    padding-top: 48px;
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hairline);
  }

  .status {
    color: var(--accent);
  }

  .status::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    background: var(--accent);
  }

  .hero-body {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-top: 48px;
  }

  .hero-name {
    font: var(--type-hero);
    letter-spacing: -0.04em;
    max-width: 10ch;
  }

  .hero-title {
    margin-top: 16px;
    font: var(--type-title);
  }

  .divider {
    color: var(--accent);
  }

  .hero-photo {
    width: 160px;
    height: 160px;
    object-fit: cover;
    filter: grayscale(1);
    flex-shrink: 0;
  }

  .hero-summary {
    margin: 32px 0;
    max-width: 60ch;
    font: var(--type-lead);
    color: var(--ink-2);
  }

  .cases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    border-top: 1px solid var(--hairline);
    border-left: 1px solid var(--hairline);
  }

  .case {
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .case-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 16px;
    text-decoration: none;
    transition: background var(--ease-state);
  }

  .case-link:hover {
    background: var(--accent-wash);
    color: inherit;
  }

  .case-metric {
    margin-top: 24px;
    font: var(--type-display);
    letter-spacing: -0.025em;
  }

  .case-title {
    margin-top: 16px;
    font: var(--type-name);
  }

  .case-summary {
    color: var(--ink-2);
    flex-grow: 1;
  }

  .case-more {
    margin-top: 16px;
    font: var(--type-control);
    color: var(--accent);
  }

  .job {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .job-period {
    padding-top: 2px;
  }

  .job-role {
    color: var(--ink-2);
  }

  .job-note {
    margin-top: 4px;
    max-width: 70ch;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
  }

  .project-name {
    font: var(--type-name);
  }

  .skills {
    font: var(--type-title);
    max-width: 50ch;
  }

  .skills-map {
    margin-top: 24px;
  }

  .footer {
    margin-bottom: 64px;
  }

  .footer-lead {
    font: var(--type-display);
    margin-bottom: 24px;
  }

  .footer-note {
    margin-top: 24px;
  }

  @media (max-width: 640px) {
    .hero-body {
      flex-direction: column-reverse;
      align-items: flex-start;
    }

    .hero-photo {
      width: 96px;
      height: 96px;
    }

    .job {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
