---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import CaseTile from '../components/CaseTile.astro';
import photo from '../assets/photo.jpg';
import { profile, experience, projects } from '../data/profile';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const techGraph = projects.find((project) => project.name === 'Tech graph');
const twoDigits = (value: number) => String(value).padStart(2, '0');
---

<Base
  title={`${profile.name} — ${profile.title} | ${profile.focus}`}
  description={profile.summary}
>
  <main class="page">
    <header class="hero">
      <div class="hero-meta mono">
        <span class="status">{profile.status}</span>
        <span>{profile.location}</span>
      </div>
      <div class="hero-body">
        <div>
          <h1 class="hero-name">{profile.name}</h1>
          <p class="hero-title">{profile.title} <span class="divider">|</span> {profile.focus}</p>
        </div>
        <Image class="hero-photo" src={photo} alt="" width={160} height={160} loading="eager" />
      </div>
      <dl class="hero-spec">
        {
          profile.spec.map((item) => (
            <div>
              <dt class="mono">{item.label}</dt>
              <dd class="hero-spec-value">{item.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="hero-summary">{profile.lead}</p>
      <ContactLinks />
    </header>

    <section class="section" aria-labelledby="work-title">
      <div class="section-head">
        <h2 class="section-title" id="work-title">Selected work</h2>
        <span class="section-index">{twoDigits(cases.length)} cases</span>
      </div>
      <ol class="cases">
        {
          cases.map((entry, index) => (
            <li class="case">
              <CaseTile entry={entry} position={index + 1} />
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="experience-title">
      <div class="section-head">
        <h2 class="section-title" id="experience-title">Experience</h2>
        <a class="section-index" href={profile.cv} download>Download CV</a>
      </div>
      <ol class="jobs">
        {
          experience.map((job) => (
            <li class="job">
              <span class="mono job-period">{job.period}</span>
              <div>
                <p class="job-head">
                  <strong>{job.company}</strong> <span class="mono">{job.country}</span>
                </p>
                <p class="job-role">{job.role}</p>
                <p class="job-note">{job.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="projects-title">
      <div class="section-head">
        <h2 class="section-title" id="projects-title">Projects</h2>
        <a class="section-index" href={profile.github} rel="me">GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="projects">
        {
          projects.map((project) => (
            <li class="project">
              <h3 class="project-name">
                {project.url ? <a href={project.url}>{project.name} <span aria-hidden="true">↗</span></a> : project.name}
              </h3>
              <p>{project.description}</p>
              <p class="mono">{project.stack}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="skills-title">
      <div class="section-head">
        <h2 class="section-title" id="skills-title">Skills</h2>
        {techGraph?.url && <a class="section-index" href={techGraph.url}>Full map in Tech graph <span aria-hidden="true">↗</span></a>}
      </div>
      <dl class="skills">
        {
          profile.skills.map((skill) => (
            <div class="skill">
              <dt class="mono">{skill.group}</dt>
              <dd>
                <ul class="skill-items">
                  {skill.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <footer class="section footer">
      <p class="footer-lead">Let’s talk.</p>
      <p class="footer-intent">{profile.contactNote}</p>
      <ContactLinks />
      <p class="mono footer-note">{profile.location}</p>
    </footer>
  </main>
</Base>

<style>
  .hero {
    padding-top: 48px;
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hairline);
  }

  .status {
    color: var(--accent);
  }

  .status::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    background: var(--accent);
  }

  .hero-body {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-top: 48px;
  }

  .hero-name {
    font: var(--type-hero);
    letter-spacing: -0.04em;
    max-width: 10ch;
  }

  .hero-title {
    margin-top: 16px;
    font: var(--type-title);
  }

  .divider {
    color: var(--accent);
  }

  .hero-photo {
    width: 160px;
    height: 160px;
    object-fit: cover;
    filter: grayscale(1);
    flex-shrink: 0;
  }

  .hero-spec {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    margin-top: 32px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
  }

  .hero-spec-value {
    margin-top: 4px;
    font: var(--type-name);
  }

  .hero-summary {
    margin: 24px 0 32px;
    max-width: var(--measure-lead);
    font: var(--type-lead);
    color: var(--ink-2);
  }

  .cases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    border-top: 1px solid var(--hairline);
    border-left: 1px solid var(--hairline);
  }

  .case {
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .job {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .job-period {
    padding-top: 2px;
  }

  .job-role {
    color: var(--ink-2);
  }

  .job-note {
    margin-top: 4px;
    max-width: var(--measure-prose);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
  }

  .project-name {
    font: var(--type-name);
  }

  .skill {
    display: grid;
    grid-template-columns: 160px 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .skill dd {
    overflow: clip;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    margin-left: -24px;
    font: var(--type-title);
  }

  .skill-items li {
    position: relative;
    margin-left: 24px;
  }

  .skill-items li::before {
    content: "·" / "";
    position: absolute;
    left: -15px;
    color: var(--ink-muted);
  }

  .footer {
    margin-bottom: 64px;
  }

  .footer-lead {
    font: var(--type-display);
  }

  .footer-intent {
    margin: 8px 0 24px;
    max-width: var(--measure-lead);
    font: var(--type-lead);
    color: var(--ink-2);
  }

  .footer-note {
    margin-top: 24px;
  }

  @media (max-width: 640px) {
    .hero-body {
      flex-direction: column-reverse;
      align-items: flex-start;
    }

    .hero-photo {
      width: 96px;
      height: 96px;
    }

    .job,
    .skill {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
