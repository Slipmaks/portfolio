---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile } from '../data/profile';
import CompoundText from '../components/CompoundText.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={`Page not found — ${profile.name}`} description="This page does not exist.">
  <div class="page">
    <nav class="crumbs mono" aria-label="Site">
      <a href="/" aria-label={`${profile.name}, home page`}><span aria-hidden="true">← </span>{profile.name}</a>
      <span class="crumbs-end">
        <span>Error 404</span>
        <ThemeToggle />
      </span>
    </nav>
  </div>
  <main class="page" id="content" tabindex="-1">
    <header class="missing">
      <h1 class="missing-title">This page doesn’t exist.</h1>
      <p class="missing-lead">The link may be old or mistyped. If you were looking for a case study, it is one of these five. The experience and CV are on the homepage.</p>
    </header>
    <ol class="missing-cases">
      {
        cases.map((entry, index) => (
          <li>
            <a href={`/work/${entry.id}/`}>
              <span class="mono">{String(index + 1).padStart(2, '0')}</span>
              <span class="missing-case-title"><CompoundText text={entry.data.title} /></span>
              <span class="mono">{entry.data.company}</span>
            </a>
          </li>
        ))
      }
    </ol>

  </main>
  <footer class="page">
    <div class="section missing-footer">
      <p class="footer-lead">Or get in touch.</p>
      <p class="footer-intent">{profile.contactNote}</p>
      <ContactLinks />
    </div>
  </footer>
</Base>

<style>
  .crumbs {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0 12px;
    border-bottom: 1px solid var(--hairline);
  }

  .crumbs-end {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
  }

  .crumbs a {
    display: inline-block;
    color: var(--ink);
    padding-block: 12px;
    margin-block: -12px;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .crumbs {
      flex-direction: column;
      gap: 8px;
    }
  }

  .missing {
    margin-top: 96px;
  }

  .missing-title {
    font: 700 clamp(32px, 5vw, 56px) / 1 var(--font-sans);
    letter-spacing: -0.035em;
    max-width: 20ch;
  }

  .missing-lead {
    margin: 24px 0 32px;
    max-width: var(--measure-lead);
    font: var(--type-lead);
    color: var(--ink-2);
  }

  .missing-cases {
    max-width: 720px;
    border-top: 1px solid var(--hairline);
  }

  .missing-cases a {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    align-items: baseline;
    gap: 4px 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
  }

  .missing-case-title {
    font: var(--type-name);
  }

  @media (max-width: 640px) {
    .missing-cases a {
      grid-template-columns: 32px 1fr;
    }

    .missing-cases a > .mono:last-child {
      grid-column: 2;
    }
  }

  .missing-footer {
    margin-bottom: 64px;
  }

  .footer-lead {
    font: var(--type-display);
  }

  .footer-intent {
    margin: 8px 0 24px;
    max-width: var(--measure-lead);
    font: var(--type-lead);
    color: var(--ink-2);
  }
</style>
